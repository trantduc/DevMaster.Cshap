<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - AdminShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">◉ AdminLTE 3</div>
            <div class="user d-flex align-items-center gap-2">
                <img src="~/images/avatars/avtCute.jpg"
                     width="35"
                     height="35"
                     class="rounded-circle"
                     style="object-fit:cover;" />
                <span>Devmaster</span>
                <div class="d-flex flex-column">
                    <a asp-controller="Accounts"
                       asp-action="Logout"
                       class="text-decoration-none small">
                        Logout
                    </a>
                </div>
            </div>
            <nav>
                <a asp-controller="Home" asp-action="Index">▦ &nbsp; Trang chính</a>
                <a asp-controller="Categories" asp-action="Index">◧ &nbsp; Category</a>
                <a asp-controller="Products" asp-action="Index">◕ &nbsp; Sản phẩm</a>
                <a asp-controller="Blogs" asp-action="Index">▤ &nbsp; Blog</a>
                <a asp-controller="Banners" asp-action="Index">▣ &nbsp; Banner</a>
                <a asp-controller="Customers" asp-action="Index">▥ &nbsp; Khách hàng</a>
                <a asp-controller="Orders" asp-action="Index">⊞ &nbsp; Đơn hàng</a>
                <a asp-controller="Accounts" asp-action="Index">● &nbsp; Account</a>
            </nav>
        </aside>

        <main class="main">
            <header class="topbar">☰ &nbsp;&nbsp; Home &nbsp;&nbsp; Contact</header>
            <section class="content">
                @RenderBody()
            </section>
            <footer>
                Copyright © 2014-2026 <b>AdminShop</b>. All rights reserved.
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>