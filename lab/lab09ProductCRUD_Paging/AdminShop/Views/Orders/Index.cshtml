@model IEnumerable<Order>
@{ViewData["Title"]="Orders";}
<h2>Orders</h2><div class="table-wrap"><table class="table table-bordered table-hover mb-0"><thead><tr><th>Id</th><th>Customer</th><th>Name</th><th>Email</th><th>CreatedDate</th><th>Status</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.Id</td><td>@x.Customer?.FullName</td><td>@x.Name</td><td>@x.Email</td><td>@x.CreatedDate</td><td>@x.Status</td></tr>}
</tbody></table></div>
