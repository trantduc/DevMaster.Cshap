@model IEnumerable<Account>
@{
    ViewData["Title"] = "Accounts";
}

<h2>Accounts</h2>

<div class="table-wrap">
    <table class="table table-bordered table-hover mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Avatar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.Email</td>
                    <td>@x.Avatar</td>
                </tr>
            }
        </tbody>
    </table>
</div>