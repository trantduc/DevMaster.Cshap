@model IEnumerable<Category>
@{ViewData["Title"]="Categories";}
<h2>Categories</h2><div class="table-wrap"><table class="table table-bordered table-hover mb-0"><thead><tr><th>Name</th><th>Status</th><th>CreatedDate</th><th>Image</th><th>Description</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Status</td><td>@x.CreatedDate</td><td>@x.Image</td><td>@x.Description</td></tr>}
</tbody></table></div>
