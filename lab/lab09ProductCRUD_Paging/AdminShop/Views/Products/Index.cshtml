@model AdminShop.ViewModels.ProductIndexVM
@{ViewData["Title"]="Sản phẩm";}
<div class="d-flex gap-2 mb-2">
<form method="get" class="d-flex gap-1">
<input class="form-control" name="keyword" value="@Model.Keyword" placeholder="Nhập tên cần tìm">
<button class="btn btn-light border" type="submit">🔍</button></form>
<a class="btn btn-primary" asp-action="Create">＋ Thêm mới</a></div>
<div class="table-wrap"><table class="table table-bordered table-hover mb-0"><thead><tr><th>Name</th><th>Status</th><th>CreatedDate</th><th>Image</th><th>Price</th><th>SalePrice</th><th>Category</th><th>Description</th><th></th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Status</td><td>@item.CreatedDate</td><td>@if(!string.IsNullOrEmpty(item.Image)){<img class="product-img" src="@item.Image">}</td><td>@item.Price.ToString("N0")</td><td>@item.SalePrice.ToString("N0")</td><td>@item.Category?.Name</td><td>@item.Description</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}
</tbody></table></div>
<nav class="mt-3"><ul class="pagination">
@if(Model.Page>1){<li class="page-item"><a class="page-link" asp-route-page="@(Model.Page-1)" asp-route-keyword="@Model.Keyword">&lt;</a></li>}
@for(int i=1;i<=Model.TotalPages;i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-page="@i" asp-route-keyword="@Model.Keyword">@i</a></li>}
@if(Model.Page<Model.TotalPages){<li class="page-item"><a class="page-link" asp-route-page="@(Model.Page+1)" asp-route-keyword="@Model.Keyword">&gt;</a></li>}
</ul></nav>
