@model Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h2>Xóa sản phẩm</h2>

<div class="form-card">
    <p>Bạn có chắc muốn xóa sản phẩm <b>@Model.Name</b>?</p>
    <p>Category: @Model.Category?.Name</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a class="btn btn-secondary" asp-action="Index">Hủy</a>
    </form>
</div>