@{
}
<div>   
    <h2>All Products</h2>
    <table class="table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>ProductName</th>
                <th>YearRelease</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in ViewBag.productListVB)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.ProductName</td>
                    <td>@product.YearRelease</td>
                    <td>$@product.Price</td>
                </tr>
            }
        </tbody>
    </table>      
</div>