@model lab04Product.Models.Product

@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm";
}

<h2>Xác nhận xóa sản phẩm</h2>
<p style="color: red; font-weight: bold;">Bạn có chắc chắn muốn xóa sản phẩm này không?</p>

<div>
    <dl class="dl-horizontal">
        <dt>Mã sản phẩm:</dt>
        <dd>@Model.Id</dd>

        <dt>Tên sản phẩm:</dt>
        <dd>@Model.Name</dd>

        <dt>Giá gốc:</dt>
        <dd>@Model.Price</dd>

        <dt>Giá khuyến mãi:</dt>
        <dd>@Model.SalePrice</dd>

        <dt>Trạng thái:</dt>
        <dd>@(Model.Status == 1 ? "Hiển thị" : "Ẩn")</dd>

        <dt>Ngày tạo:</dt>
        <dd>@Model.CreatedDate</dd>

        <dt>Mô tả:</dt>
        <dd>@Model.Description</dd>

        <dt>Hình ảnh:</dt>
        <dd>
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="~/images/@Model.Image" width="150" />
            }
            else
            {
                <span>Không có ảnh</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Hủy</a>
    </form>
</div>