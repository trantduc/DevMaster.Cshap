@model IEnumerable<lab04Product.Models.Product>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}
<h2>Danh sách sản phẩm</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới sản phẩm</a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên sản phẩm</th>
            <th>Giá gốc</th>
            <th>Giá KM</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Hình ảnh</th>
            <th>Mã danh mục</th>
            <th>Mô tả</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.SalePrice</td>
                    <td>@(item.Status == 1 ? "Hiển thị" : "Ẩn")</td>
                    <td>@item.CreatedDate</td>
                    <td>
                        <img src="~/images/@item.Image" width="60" height="60" style="object-fit: cover;" />
                    </td>
                    <td>@item.CategoryId</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">Chưa có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>