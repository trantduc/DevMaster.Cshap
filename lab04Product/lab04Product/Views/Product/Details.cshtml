@model lab04Product.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2>Chi tiết sản phẩm</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Mã sản phẩm:</dt>
        <dd>@Model.Id</dd>

        <dt>Tên sản phẩm:</dt>
        <dd>@Model.Name</dd>

        <dt>Giá gốc:</dt>
        <dd>@Model.Price</dd>

        <dt>Giá khuyến mãi:</dt>
        <dd>@Model.SalePrice</dd>

        <dt>Trạng thái:</dt>
        <dd>@(Model.Status == 1 ? "Hiển thị" : "Ẩn")</dd>

        <dt>Ngày tạo:</dt>
        <dd>@Model.CreatedDate</dd>

        <dt>Mô tả:</dt>
        <dd>@Model.Description</dd>

        <dt>Hình ảnh:</dt>
        <dd>
            <img src="~/images/@Model.Image" width="150" />
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Index">Quay lại danh sách</a>
</p>