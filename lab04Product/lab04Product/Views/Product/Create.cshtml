@model lab04Product.Models.Product

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<h2>Thêm mới sản phẩm</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="form-group mb-3">
                <label class="control-label">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Giá gốc</label>
                <input asp-for="Price" type="number" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Giá khuyến mãi</label>
                <input asp-for="SalePrice" type="number" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Trạng thái (1: Hiển thị, 0: Ẩn)</label>
                <input asp-for="Status" type="number" class="form-control" value="1" />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Hình ảnh sản phẩm</label>
                <input type="file" name="files" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Danh mục</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                    <option value="">-- Chọn danh mục --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu sản phẩm" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>

        </form>
    </div>
</div>